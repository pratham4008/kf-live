# alpaca = live paper trading, sim = offline synthetic market (development only)
MODE=alpaca
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_LIVE_FEED=iex
ALPACA_HISTORY_FEED=sip

# The pair your screen_pairs.py run selected. y and x as in run_backtest.py --y/--x
SYMBOL_Y=EWA
SYMBOL_X=EWC
BENCHMARK=SPY

# The filter always runs from this date, so each day's decision extends the same path
ANCHOR_START=2016-01-04

# Keep these identical to DEFAULTS in the research repo's config.py
KF_DELTA=0.0001
KF_R=0.001
ZSCORE_WINDOW=60
ENTRY_Z=2.0
EXIT_Z=0.5
STOP_Z=4.0
REBALANCE_HEDGE=true

# Live-only settings
GROSS_EXPOSURE=1.0
MIN_TRADE_DOLLARS=200
DECISION_MINUTES_BEFORE_CLOSE=10
SNAPSHOT_SECONDS=300
DB_PATH=/data/live.db

# Your portfolio's origin, comma-separated if several
ALLOWED_ORIGINS=https://pratham4008.github.io
